{
  "name": "Default Protocol",
  "description": "Heat and scaffold under NVT, pack under NPgT for 20 ns of MD (Eq1–6), then production in the selected ensemble",
  "compute_defaults": {
    "cpu_cores": 6,
    "gpu_id": 0,
    "num_gpus": 1,
    "use_gpu": true,
    "compute_target": "auto"
  },
  "stages": [
    {
      "name": "Minimization",
      "description": "Relax bad contacts from building. Protein and lipids stay held in place, and water can move freely.",
      "stage_kind": "minimization",
      "time_ns": 0,
      "steps": 0,
      "ensemble": "NVT",
      "temperature": 303.15,
      "pressure": 1.0,
      "minimize_steps": 10000,
      "cpu_cores": 6,
      "gpu_id": 0,
      "num_gpus": 0,
      "use_gpu": false,
      "resources_inherit": false,
      "constraints": [
        { "name": "Protein backbone", "force_constant": 10.0, "selection": "protein_backbone" },
        { "name": "Protein sidechain", "force_constant": 5.0, "selection": "protein_sidechain" },
        { "name": "Lipid head", "force_constant": 2.5, "selection": "lipid_head" },
        { "name": "Lipid tail", "force_constant": 2.5, "selection": "lipid_tail" },
        { "name": "Water", "force_constant": 0.0, "selection": "water" },
        { "name": "Ions", "force_constant": 5.0, "selection": "ions" },
        { "name": "Other", "force_constant": 0.0, "selection": "other" }
      ],
      "timestep": 1.0,
      "dcd_freq": 5000
    },
    {
      "name": "Equilibration 1",
      "description": "Warm the system to the target temperature while keeping the membrane scaffold restrained. Box size stays fixed for now.",
      "stage_kind": "equilibration",
      "resources_inherit": true,
      "time_ns": 0.125,
      "steps": 125000,
      "ensemble": "NVT",
      "temperature": 303.15,
      "pressure": 1.0,
      "constraints": [
        { "name": "Protein backbone", "force_constant": 10.0, "selection": "protein_backbone" },
        { "name": "Protein sidechain", "force_constant": 5.0, "selection": "protein_sidechain" },
        { "name": "Lipid head", "force_constant": 2.5, "selection": "lipid_head" },
        { "name": "Lipid tail", "force_constant": 2.5, "selection": "lipid_tail" },
        { "name": "Water", "force_constant": 0.0, "selection": "water" },
        { "name": "Ions", "force_constant": 0.0, "selection": "ions" },
        { "name": "Other", "force_constant": 0.0, "selection": "other" }
      ],
      "timestep": 1.0,
      "dcd_freq": 5000
    },
    {
      "name": "Equilibration 2",
      "description": "Hold the membrane scaffold under NVT with strong restraints so solvent and packing defects can settle before the box is allowed to change.",
      "stage_kind": "equilibration",
      "resources_inherit": true,
      "time_ns": 0.5,
      "steps": 500000,
      "ensemble": "NVT",
      "temperature": 303.15,
      "pressure": 1.0,
      "constraints": [
        { "name": "Protein backbone", "force_constant": 10.0, "selection": "protein_backbone" },
        { "name": "Protein sidechain", "force_constant": 5.0, "selection": "protein_sidechain" },
        { "name": "Lipid head", "force_constant": 5.0, "selection": "lipid_head" },
        { "name": "Lipid tail", "force_constant": 5.0, "selection": "lipid_tail" },
        { "name": "Water", "force_constant": 0.0, "selection": "water" },
        { "name": "Ions", "force_constant": 0.0, "selection": "ions" },
        { "name": "Other", "force_constant": 0.0, "selection": "other" }
      ],
      "timestep": 1.0,
      "dcd_freq": 5000,
      "margin": 5.0
    },
    {
      "name": "Equilibration 3",
      "description": "Open NPgT packing (γ=0): the box can shrink to fill gaps while lipid tails loosen so area and thickness can start to settle.",
      "stage_kind": "equilibration",
      "resources_inherit": true,
      "time_ns": 0.25,
      "steps": 250000,
      "ensemble": "NPgT",
      "temperature": 303.15,
      "pressure": 1.0,
      "surface_tension": 0.0,
      "constraints": [
        { "name": "Protein backbone", "force_constant": 5.0, "selection": "protein_backbone" },
        { "name": "Protein sidechain", "force_constant": 2.5, "selection": "protein_sidechain" },
        { "name": "Lipid head", "force_constant": 2.5, "selection": "lipid_head" },
        { "name": "Lipid tail", "force_constant": 0.0, "selection": "lipid_tail" },
        { "name": "Water", "force_constant": 0.0, "selection": "water" },
        { "name": "Ions", "force_constant": 0.0, "selection": "ions" },
        { "name": "Other", "force_constant": 0.0, "selection": "other" }
      ],
      "timestep": 1.0,
      "dcd_freq": 5000,
      "margin": 5.0
    },
    {
      "name": "Equilibration 4",
      "description": "Release the lipid headgroups so the membrane can contract laterally toward a realistic area per lipid.",
      "stage_kind": "equilibration",
      "resources_inherit": true,
      "time_ns": 0.5,
      "steps": 500000,
      "ensemble": "NPgT",
      "temperature": 303.15,
      "pressure": 1.0,
      "surface_tension": 0.0,
      "constraints": [
        { "name": "Protein backbone", "force_constant": 2.5, "selection": "protein_backbone" },
        { "name": "Protein sidechain", "force_constant": 1.0, "selection": "protein_sidechain" },
        { "name": "Lipid head", "force_constant": 0.0, "selection": "lipid_head" },
        { "name": "Lipid tail", "force_constant": 0.0, "selection": "lipid_tail" },
        { "name": "Water", "force_constant": 0.0, "selection": "water" },
        { "name": "Ions", "force_constant": 0.0, "selection": "ions" },
        { "name": "Other", "force_constant": 0.0, "selection": "other" }
      ],
      "timestep": 1.0,
      "dcd_freq": 5000,
      "margin": 5.0
    },
    {
      "name": "Equilibration 5",
      "description": "Continue NPgT packing with a stronger backbone hold so the protein does not drift while the membrane still has area to lose.",
      "stage_kind": "equilibration",
      "resources_inherit": true,
      "time_ns": 1.0,
      "steps": 500000,
      "ensemble": "NPgT",
      "temperature": 303.15,
      "pressure": 1.0,
      "surface_tension": 0.0,
      "constraints": [
        { "name": "Protein backbone", "force_constant": 1.0, "selection": "protein_backbone" },
        { "name": "Protein sidechain", "force_constant": 0.0, "selection": "protein_sidechain" },
        { "name": "Lipid head", "force_constant": 0.0, "selection": "lipid_head" },
        { "name": "Lipid tail", "force_constant": 0.0, "selection": "lipid_tail" },
        { "name": "Water", "force_constant": 0.0, "selection": "water" },
        { "name": "Ions", "force_constant": 0.0, "selection": "ions" },
        { "name": "Other", "force_constant": 0.0, "selection": "other" }
      ],
      "timestep": 2.0,
      "dcd_freq": 5000,
      "margin": 5.0
    },
    {
      "name": "Equilibration 6",
      "description": "Long NPgT packing (γ=0) with a light backbone hold so area and thickness can settle before production switches to the sidebar ensemble.",
      "stage_kind": "equilibration",
      "resources_inherit": true,
      "time_ns": 17.625,
      "steps": 8812500,
      "ensemble": "NPgT",
      "temperature": 303.15,
      "pressure": 1.0,
      "surface_tension": 0.0,
      "constraints": [
        { "name": "Protein backbone", "force_constant": 0.1, "selection": "protein_backbone" },
        { "name": "Protein sidechain", "force_constant": 0.0, "selection": "protein_sidechain" },
        { "name": "Lipid head", "force_constant": 0.0, "selection": "lipid_head" },
        { "name": "Lipid tail", "force_constant": 0.0, "selection": "lipid_tail" },
        { "name": "Water", "force_constant": 0.0, "selection": "water" },
        { "name": "Ions", "force_constant": 0.0, "selection": "ions" },
        { "name": "Other", "force_constant": 0.0, "selection": "other" }
      ],
      "timestep": 2.0,
      "dcd_freq": 50000,
      "margin": 5.0
    },
    {
      "name": "Production",
      "description": "Long production run in the ensemble selected in the sidebar, with no positional restraints.",
      "stage_kind": "production",
      "resources_inherit": false,
      "cpu_cores": 6,
      "gpu_id": 0,
      "num_gpus": 1,
      "use_gpu": true,
      "time_ns": 100.0,
      "steps": 50000000,
      "ensemble": null,
      "temperature": 303.15,
      "pressure": 1.0,
      "surface_tension": 0.0,
      "constraints": [
        { "name": "Protein backbone", "force_constant": 0.0, "selection": "protein_backbone" },
        { "name": "Protein sidechain", "force_constant": 0.0, "selection": "protein_sidechain" },
        { "name": "Lipid head", "force_constant": 0.0, "selection": "lipid_head" },
        { "name": "Lipid tail", "force_constant": 0.0, "selection": "lipid_tail" },
        { "name": "Water", "force_constant": 0.0, "selection": "water" },
        { "name": "Ions", "force_constant": 0.0, "selection": "ions" },
        { "name": "Other", "force_constant": 0.0, "selection": "other" }
      ],
      "timestep": 2.0,
      "dcd_freq": 50000,
      "margin": 5.0
    }
  ],
  "selections": {
    "protein_backbone": "protein and backbone",
    "protein_sidechain": "protein and not backbone",
    "lipid_head": "(resname POPC POPE POPS DPPC DMPC DOPC DSPC PC PE PS PA PG PI SM OL LA MY ST AR OLE PAL STE LIN CHOL CHL CHOLEST PALM OLEO STEROL) and (name P O11 O12 O13 O14 O21 O22 O31 O32 O33 O34 O1P O2P O3P O4P OP1 OP2 OP3 OP4 N C11 C12 C13 C14 N31 C32 C33 C34 C35 C1 C2 C3 HN1 HN2 HN3 HO2 HO3 HS)",
    "lipid_tail": "(resname POPC POPE POPS DPPC DMPC DOPC DSPC PC PE PS PA PG PI SM OL LA MY ST AR OLE PAL STE LIN CHOL CHL CHOLEST PALM OLEO STEROL) and not (name P O11 O12 O13 O14 O21 O22 O31 O32 O33 O34 O1P O2P O3P O4P OP1 OP2 OP3 OP4 N C11 C12 C13 C14 N31 C32 C33 C34 C35 C1 C2 C3 HN1 HN2 HN3 HO2 HO3 HS)",
    "water": "resname TIP3 HOH WAT SOL TIP4 SPC T3P T4P",
    "ions": "resname NA CL K CA MG ZN FE CU SOD CLA POT CAL MAG ZIN IRN COP Na+ Cl- K+ Ca2+ Mg2+ Zn2+ Fe2+ Fe3+ Cu2+ NA+ CL- LIT RUB CES BAR",
    "other": "not (protein or (resname POPC POPE POPS DPPC DMPC DOPC DSPC PC PE PS PA PG PI SM OL LA MY ST AR OLE PAL STE LIN CHOL CHL CHOLEST PALM OLEO STEROL) or (resname TIP3 HOH WAT SOL TIP4 SPC T3P T4P) or (resname NA CL K CA MG ZN FE CU SOD CLA POT CAL MAG ZIN IRN COP Na+ Cl- K+ Ca2+ Mg2+ Zn2+ Fe2+ Fe3+ Cu2+ NA+ CL- LIT RUB CES BAR))"
  }
}
